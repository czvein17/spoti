{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun-types"],
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
