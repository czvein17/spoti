NODE_ENV=development
PORT=3000

# Required: replace user and password with the PostgreSQL sandbox credentials.
DATABASE_URL=postgres://user:password@localhost:1717/lounge

# Optional: uncomment only when Hono does not run at http://localhost:3000.
# API_PROXY_TARGET=http://localhost:3000

# Optional: uncomment only for browsers that call Hono from another origin.
# Use a comma-separated list of exact origins. The Vite proxy does not need this.
# CORS_ORIGINS=https://app.example.com
