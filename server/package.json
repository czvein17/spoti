{
	"name": "server",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"test": "bun test src",
		"dev": "concurrently --kill-others \"bun --watch run src/server.ts\" \"tsc --watch\""
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@app/db": "workspace:*",
		"concurrently": "^10.0.5",
		"hono": "^4.10.8",
		"http-status-codes": "^2.3.0",
		"shared": "workspace:*",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
